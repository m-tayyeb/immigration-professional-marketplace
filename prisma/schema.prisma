generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalType {
  IMMIGRATION_LAWYER
  ACCREDITED_ADVISER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CredentialStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MatterType {
  IMMIGRATION
  INTEGRATION
  LICENSE_CONVERSION
  LICENSE_UPGRADE_GUIDE
  SOCIAL_BENEFIT_GUIDANCE
  OTHER
}

enum CaseStatus {
  AWAITING_ASSESSMENT_REVIEW
  ASSESSMENT_REQUEST_DECLINED
  ASSESSMENT_REQUEST_WITHDRAWN
  AWAITING_ASSESSMENT_PAYMENT
  ASSESSMENT_PAID
  ASSESSMENT_IN_PROGRESS
  AWAITING_CLIENT_DECISION
  AWAITING_DOCUMENTS_AND_PAYMENT
  DOCUMENT_REVIEW
  MAIN_WORK_IN_PROGRESS
  PREPARING_DOCUMENTS
  FILE_PREPARATION
  FILE_READY_FOR_REVIEW
  COMPLETED
  CANCELLED
}

enum PaymentStage {
  ASSESSMENT
  REMAINING_BALANCE
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum DocumentFolder {
  CLIENT
  PROFESSIONAL
}

enum DocumentRequirementStatus {
  REQUESTED
  RECEIVED
  ACCEPTED
  REPLACEMENT_REQUIRED
}

enum DocumentUploadActor {
  CLIENT
  PROFESSIONAL
}

enum AssessmentOutcome {
  ELIGIBLE
  POTENTIALLY_ELIGIBLE
  MORE_INFORMATION_REQUIRED
  NOT_RECOMMENDED
}

enum ClientDecision {
  PROCEED
  DO_NOT_PROCEED
}

enum ConsultationMethod {
  ONLINE
  TELEPHONE
  FACE_TO_FACE
}

enum CaseAppointmentPurpose {
  ASSESSMENT_CONSULTATION
  FINAL_FILE_REVIEW
  SUPPLEMENTARY_REQUEST
}

enum CaseAppointmentStatus {
  PROPOSED
  CHANGE_REQUESTED
  CONFIRMED
  WITHDRAWN
  CANCELLED
  COMPLETED
}

enum AppointmentConfirmationSource {
  TELEPHONE
  EXTERNAL_MESSAGE
  FACE_TO_FACE
  OTHER
}

enum AppointmentMessageKind {
  MESSAGE
  CHANGE_REQUEST
  WITHDRAWAL
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String
  role                 UserRole              @default(CLIENT)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  passwordHash         String?
  professionalProfile  ProfessionalProfile?
  consultationRequests ConsultationRequest[] @relation("ClientRequests")
  reviews              Review[]              @relation("ClientReviews")
  notifications        Notification[]
  clientCases          Case[]                @relation("ClientCases")
  authoredMessages     CaseMessage[]
  uploadedDocuments    CaseDocument[]
  clientProfile        ClientProfile?
  proposedAppointmentRevisions CaseAppointmentRevision[] @relation("AppointmentRevisionProposer")
  acceptedAppointmentRevisions CaseAppointmentRevision[] @relation("AppointmentRevisionAcceptor")
  bookedAppointments           CaseAppointment[]         @relation("AppointmentBooker")
  appointmentMessages          CaseAppointmentMessage[]
  serviceDecisions             CaseServiceDecision[]
  confirmedDocumentCollections CaseDocumentCompletion[] @relation("DocumentCompletionConfirmer")
  documentRemindersSent         CaseDocumentReminder[]   @relation("DocumentReminderSender")
  filesMarkedReady              Case[]                   @relation("FileReadyBy")
}

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  telephone   String
  addressLine String
  city        String
  postalCode  String
  country     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CaseContactSnapshot {
  id          String   @id @default(cuid())
  caseId      String   @unique
  fullName    String
  email       String
  telephone   String
  addressLine String
  city        String
  postalCode  String
  country     String
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ProfessionalProfile {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  professionalType     ProfessionalType
  bio                  String                 @db.Text
  location             String
  yearsOfExperience    Int
  verificationStatus   VerificationStatus     @default(PENDING)
  acceptingNewCases    Boolean                @default(false)
  rating               Decimal                @default(0) @db.Decimal(3, 2)
  reviewCount          Int                    @default(0)
  completedCases       Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services             ProfessionalService[]
  countries            ProfessionalCountry[]
  languages            ProfessionalLanguage[]
  credentials          Credential[]
  consultationRequests ConsultationRequest[]
  reviews              Review[]
  cases                Case[]

  @@index([verificationStatus])
  @@index([verificationStatus, acceptingNewCases])
  @@index([professionalType])
}

model Country {
  id                    String                @id @default(cuid())
  name                  String                @unique
  code                  String                @unique @db.Char(2)
  createdAt             DateTime              @default(now())
  professionalCountries ProfessionalCountry[]
  consultationRequests  ConsultationRequest[]
  cases                 Case[]
}

model ImmigrationService {
  id                   String                @id @default(cuid())
  name                 String                @unique
  description          String                @db.Text
  createdAt            DateTime              @default(now())
  code                 String?               @unique
  totalPrice           Decimal?              @db.Decimal(10, 2)
  assessmentFee        Decimal               @default(100) @db.Decimal(10, 2)
  active               Boolean               @default(true)
  professionalServices ProfessionalService[]
  consultationRequests ConsultationRequest[]
  cases                Case[]
}

model ProfessionalService {
  id              String              @id @default(cuid())
  professionalId  String
  serviceId       String
  price           Decimal             @db.Decimal(10, 2)
  durationMinutes Int
  description     String              @db.Text
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service         ImmigrationService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([professionalId, serviceId])
  @@index([serviceId])
}

model ProfessionalCountry {
  professionalId String
  countryId      String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  country        Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([professionalId, countryId])
  @@index([countryId])
}

model ProfessionalLanguage {
  professionalId String
  language       String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([professionalId, language])
}

model Credential {
  id               String              @id @default(cuid())
  professionalId   String
  credentialType   String
  issuingAuthority String
  credentialNumber String
  status           CredentialStatus    @default(PENDING)
  createdAt        DateTime            @default(now())
  professional     ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([issuingAuthority, credentialNumber])
  @@index([professionalId, status])
}

model ConsultationRequest {
  id                String              @id @default(cuid())
  clientId          String
  professionalId    String
  countryId         String
  serviceId         String
  description       String              @db.Text
  preferredLanguage String
  preferredDateTime DateTime?
  status            ConsultationStatus  @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  client            User                @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Restrict)
  professional      ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  country           Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  service           ImmigrationService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointment       Appointment?
  review            Review?

  @@index([clientId, status])
  @@index([professionalId, status])
  @@index([countryId, serviceId])
}

model Appointment {
  id                    String              @id @default(cuid())
  consultationRequestId String              @unique
  scheduledAt           DateTime
  durationMinutes       Int
  status                AppointmentStatus   @default(SCHEDULED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  consultationRequest   ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
}

model Review {
  id                    String              @id @default(cuid())
  clientId              String
  professionalId        String
  consultationRequestId String              @unique
  rating                Int
  comment               String              @db.Text
  createdAt             DateTime            @default(now())
  client                User                @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Restrict)
  professional          ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  consultationRequest   ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)

  @@index([professionalId, createdAt])
  @@index([clientId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())
  caseId    String?
  appointmentId String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appointment CaseAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([caseId])
  @@index([appointmentId])
}

model Case {
  id                String              @id @default(cuid())
  clientId          String
  professionalId    String
  countryId         String
  serviceId         String
  matterType        MatterType          @default(IMMIGRATION)
  matterDescription String?             @db.Text
  situationDescription       String?             @db.Text
  preferredConsultationMethod ConsultationMethod?
  preferredAvailability      String?             @db.Text
  relevantDeadline           DateTime?
  additionalMessage          String?             @db.Text
  confirmedConsultationMethod ConsultationMethod?
  appointmentAtUtc           DateTime?            @db.Timestamptz(3)
  appointmentTimeZone        String?
  professionalMessage        String?             @db.Text
  appointmentInstructions    String?             @db.Text
  declineReason              String?             @db.Text
  status            CaseStatus          @default(AWAITING_ASSESSMENT_REVIEW)
  clientAgreedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  completedAt       DateTime?
  client            User                @relation("ClientCases", fields: [clientId], references: [id], onDelete: Restrict)
  professional      ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  country           Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  service           ImmigrationService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments          PaymentRequest[]
  checklist         CaseChecklistItem[]
  documents         CaseDocument[]
  timeline          CaseTimelineEvent[]
  messages          CaseMessage[]
  assessment        CaseAssessment?
  contactSnapshot   CaseContactSnapshot?
  appointments      CaseAppointment[]
  notifications     Notification[]
  serviceDecision   CaseServiceDecision?
  documentRequirements CaseDocumentRequirement[]
  documentCompletion CaseDocumentCompletion?
  documentReminders CaseDocumentReminder[]
  fileReadyAt       DateTime?
  fileReadyById     String?
  fileReadyBy       User? @relation("FileReadyBy", fields: [fileReadyById], references: [id], onDelete: Restrict)

  @@index([clientId, status])
  @@index([professionalId, status])
}

model CaseServiceDecision {
  id                              String         @id @default(cuid())
  caseId                          String         @unique
  clientId                        String
  decision                        ClientDecision
  decidedAt                       DateTime       @default(now())
  assessmentPaidAmount            Decimal?       @db.Decimal(10, 2)
  totalServiceAmount              Decimal?       @db.Decimal(10, 2)
  remainingAmountAcknowledged     Decimal?       @db.Decimal(10, 2)
  financialObligationConfirmed    Boolean        @default(false)
  agreementVersion                String?
  agreementText                   String?        @db.Text
  case                            Case           @relation(fields: [caseId], references: [id], onDelete: Restrict)
  client                          User           @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, decidedAt])
}

model CaseDocumentRequirement {
  id          String                    @id @default(cuid())
  caseId      String
  title       String
  description String?                   @db.Text
  status      DocumentRequirementStatus @default(REQUESTED)
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  case        Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documents   CaseDocument[]

  @@index([caseId, active, status])
}

model CaseDocumentCompletion {
  id            String   @id @default(cuid())
  caseId        String   @unique
  confirmedById String
  confirmedAt   DateTime @default(now())
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  confirmedBy   User     @relation("DocumentCompletionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
}

model CaseDocumentReminder {
  id        String   @id @default(cuid())
  caseId    String
  sentById  String
  sentAt    DateTime @default(now())
  dedupeKey String   @unique
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sentBy    User     @relation("DocumentReminderSender", fields: [sentById], references: [id], onDelete: Restrict)

  @@index([caseId, sentAt])
}

model CaseAppointment {
  id                    String                        @id @default(cuid())
  caseId                String
  purpose               CaseAppointmentPurpose
  status                CaseAppointmentStatus        @default(PROPOSED)
  method                ConsultationMethod?
  appointmentAtUtc      DateTime?                     @db.Timestamptz(3)
  timeZone              String?
  instructions          String?                       @db.Text
  professionalMessage   String?                       @db.Text
  bookedById            String?
  confirmationSource    AppointmentConfirmationSource?
  confirmationNote      String?                       @db.Text
  confirmedAt           DateTime?
  changeRequestedAt     DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?                       @db.Text
  withdrawnAt           DateTime?
  withdrawalReason      String?                       @db.Text
  completedAt           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  case                  Case                          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  bookedBy              User?                         @relation("AppointmentBooker", fields: [bookedById], references: [id], onDelete: Restrict)
  revisions             CaseAppointmentRevision[]
  messages              CaseAppointmentMessage[]
  notifications         Notification[]

  @@index([caseId, purpose])
  @@index([caseId, status])
}

model CaseAppointmentRevision {
  id                String                @id @default(cuid())
  appointmentId     String
  proposedById      String
  method            ConsultationMethod
  appointmentAtUtc  DateTime              @db.Timestamptz(3)
  timeZone          String
  instructions      String                @db.Text
  message           String?               @db.Text
  createdAt         DateTime              @default(now())
  acceptedAt        DateTime?
  acceptedById      String?
  appointment       CaseAppointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  proposedBy        User                  @relation("AppointmentRevisionProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  acceptedBy        User?                 @relation("AppointmentRevisionAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
}

model CaseAppointmentMessage {
  id            String                 @id @default(cuid())
  appointmentId String
  authorId      String
  kind          AppointmentMessageKind @default(MESSAGE)
  body          String                 @db.Text
  createdAt     DateTime               @default(now())
  appointment   CaseAppointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author        User                   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
}

model CaseAssessment {
  id               String            @id @default(cuid())
  caseId           String            @unique
  outcome          AssessmentOutcome
  assessmentText   String            @db.Text
  recommendedRoute String
  issuesRisks      String            @db.Text
  nextSteps        String            @db.Text
  releasedAt       DateTime
  clientDecision   ClientDecision?
  decidedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  case             Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model PaymentRequest {
  id                String        @id @default(cuid())
  caseId            String
  stage             PaymentStage
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EUR") @db.Char(3)
  status            PaymentStatus @default(PENDING)
  providerReference String?
  requestedAt       DateTime      @default(now())
  paidAt            DateTime?
  case              Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, stage])
  @@index([status])
}

model CaseChecklistItem {
  id           String    @id @default(cuid())
  caseId       String
  title        String
  description  String?   @db.Text
  clientAction Boolean   @default(false)
  position     Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, position])
}

model CaseDocument {
  id                 String         @id @default(cuid())
  caseId             String
  uploadedById       String
  folder             DocumentFolder
  fileName           String
  storageKey         String         @unique
  mimeType           String
  size               Int
  releasedToClientAt DateTime?
  requirementId      String?
  uploadActor        DocumentUploadActor?
  externalSourceNote String?        @db.Text
  createdAt          DateTime       @default(now())
  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy         User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  requirement        CaseDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@index([caseId, folder])
  @@index([requirementId, createdAt])
}

model CaseTimelineEvent {
  id              String   @id @default(cuid())
  caseId          String
  title           String
  details         String?  @db.Text
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model CaseMessage {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  body      String   @db.Text
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}
